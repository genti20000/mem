rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Legacy application is an archive until migrated and secured.
    // All access requires an authenticated and verified Firebase admin account,
    // explicitly provisioned through the protected /admins/{uid} collection.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /members/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    match /visits/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    match /incidents/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /door_logs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /audit_logs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /club_rules/{id} {
      allow read, write: if isAdmin();
    }

    // Admin enrolment must occur via Firebase console or Admin SDK,
    // never by a browser creating its own admin document.
    match /admins/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
